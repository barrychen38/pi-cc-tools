{
  "name": "pi-claude-style-tools",
  "version": "1.0.65",
  "description": "Compact Pi tool rendering with Claude-style call rows and result summaries",
  "keywords": [
    "pi-package",
    "pi-extension",
    "claude-code",
    "pi",
    "tool-renderer",
    "mcp",
    "minimal-output"
  ],
  "license": "MIT",
  "author": "FammasMaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FammasMaz/pi-cc-tools.git"
  },
  "homepage": "https://github.com/FammasMaz/pi-cc-tools#readme",
  "bugs": {
    "url": "https://github.com/FammasMaz/pi-cc-tools/issues"
  },
  "files": [
    "extensions/index.ts",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun scripts/test-render-cache.ts",
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/index.ts",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry-run": "npm publish --dry-run",
    "bench:tools": "bun scripts/benchmark-tools.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3"
  }
}
